<resources>
    <style name="Theme.IPTVLive" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:colorAccent">#51D6C4</item>
        <item name="android:navigationBarColor">#070B12</item>
    </style>
    <style name="NavButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">58dp</item><item name="android:layout_marginBottom">8dp</item>
        <item name="android:gravity">center_vertical|start</item><item name="android:paddingLeft">18dp</item><item name="android:paddingRight">18dp</item><item name="android:textColor">@color/nav_button_text</item><item name="android:textSize">18sp</item><item name="android:textStyle">bold</item><item name="android:focusable">true</item><item name="android:background">@drawable/nav_button_background</item><item name="android:stateListAnimator">@null</item>
    </style>
    <style name="HomeActionButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">360dp</item><item name="android:layout_height">64dp</item><item name="android:layout_marginBottom">14dp</item><item name="android:textSize">19sp</item><item name="android:focusable">true</item>
    </style>
    <style name="SettingLabel">
        <item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item><item name="android:layout_marginBottom">10dp</item><item name="android:textColor">#A8B5C5</item><item name="android:textSize">16sp</item>
    </style>
    <style name="SettingButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">360dp</item><item name="android:layout_height">60dp</item><item name="android:textSize">18sp</item><item name="android:textStyle">bold</item><item name="android:textColor">#FFFFFF</item><item name="android:focusable">true</item><item name="android:background">@drawable/setting_control_background</item><item name="android:stateListAnimator">@null</item>
    </style>
</resources>
