<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/cast_button_background"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp"
    android:layout_marginBottom="6dp">

    <ImageView
        android:id="@+id/cast_device_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_cast"
        android:tint="#78FFF0"
        android:contentDescription="Device Icon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/cast_device_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cast_device_ip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#8290A3"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/cast_device_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/cast_button_background"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:textColor="#3196F3"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
