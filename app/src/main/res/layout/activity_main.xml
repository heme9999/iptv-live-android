<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#070B12" android:orientation="horizontal">
    <LinearLayout android:id="@+id/nav_rail" android:layout_width="190dp" android:layout_height="match_parent" android:background="#0B121D" android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="24dp" android:text="My IPTV" android:textColor="#78FFF0" android:textSize="22sp" android:textStyle="bold" />
        <Button android:id="@+id/nav_home" style="@style/NavButton" android:text="主页" />
        <Button android:id="@+id/nav_live" style="@style/NavButton" android:text="直播" />
        <Button android:id="@+id/nav_categories" style="@style/NavButton" android:text="分类" />
        <Button android:id="@+id/nav_settings" style="@style/NavButton" android:text="设置" />
        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
        <TextView android:id="@+id/nav_version" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#8290A3" android:textSize="12sp" />
    </LinearLayout>
    <FrameLayout android:id="@+id/page_container" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
        <LinearLayout android:id="@+id/page_home" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▣  电视直播大厅" android:textColor="#F4F7FA" android:textSize="30sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="高清直播 · 频道延时实时测速" android:textColor="#9AA9BC" android:textSize="14sp" />
                </LinearLayout>
                <Button android:id="@+id/home_continue" android:layout_width="240dp" android:layout_height="54dp" android:backgroundTint="#3196F3" android:focusable="true" android:text="▶  继续播放" android:textColor="#07101A" android:textStyle="bold" />
            </LinearLayout>
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="62dp" android:scrollbars="none">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal">
                    <Button android:id="@+id/home_live" style="@style/NavButton" android:layout_marginEnd="12dp" android:text="全部频道" />
                    <Button android:id="@+id/home_categories" style="@style/NavButton" android:layout_marginEnd="12dp" android:text="频道分类" />
                    <Button android:id="@+id/home_refresh" style="@style/NavButton" android:text="🔄 刷新列表" />
                </LinearLayout>
            </HorizontalScrollView>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/home_channels" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="24dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/page_live" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:visibility="gone">
            <LinearLayout android:id="@+id/sidebar" android:layout_width="330dp" android:layout_height="match_parent" android:background="#0E1723" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="12dp" android:text="全部频道" android:textColor="#F4F7FA" android:textSize="20sp" android:textStyle="bold" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/channels" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="24dp" />
            </LinearLayout>
            <androidx.media3.ui.PlayerView android:id="@+id/player_view" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:keepScreenOn="true" app:show_buffering="when_playing" app:use_controller="true" />
        </LinearLayout>
        <LinearLayout android:id="@+id/page_categories" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:padding="24dp" android:visibility="gone">
            <LinearLayout android:layout_width="300dp" android:layout_height="match_parent" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="14dp" android:text="频道分类" android:textColor="#F4F7FA" android:textSize="24sp" android:textStyle="bold" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/category_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="28dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/category_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="14dp" android:text="请选择分类" android:textColor="#78FFF0" android:textSize="24sp" android:textStyle="bold" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/category_channels" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>
        <ScrollView android:id="@+id/page_settings" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="48dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="30dp" android:text="设置" android:textColor="#F4F7FA" android:textSize="32sp" android:textStyle="bold" />
                <TextView style="@style/SettingLabel" android:text="启动后进入" />
                <Spinner android:id="@+id/startup_page" android:layout_width="360dp" android:layout_height="58dp" android:background="@drawable/setting_control_background" android:focusable="true" android:popupBackground="#111C2A" />
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/autoplay" android:layout_width="wrap_content" android:layout_height="64dp" android:layout_marginTop="24dp" android:background="@drawable/setting_control_background" android:focusable="true" android:minWidth="520dp" android:paddingLeft="18dp" android:paddingRight="18dp" android:text="进入直播时自动播放第一个频道" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
                <TextView style="@style/SettingLabel" android:layout_marginTop="28dp" android:text="播放源管理" />
                <TextView android:id="@+id/source_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="当前播放源：官方内置源" android:textColor="#8290A3" android:textSize="15sp" />
                <Button android:id="@+id/btn_refresh_playlist" style="@style/SettingButton" android:layout_width="wrap_content" android:layout_height="58dp" android:layout_marginTop="14dp" android:backgroundTint="#3196F3" android:paddingLeft="24dp" android:paddingRight="24dp" android:text="🔄  立即刷新同步播放清单" android:textColor="#07101A" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                    <Button android:id="@+id/btn_edit_source" style="@style/SettingButton" android:layout_marginEnd="16dp" android:text="添加 / 更换播放源" />
                    <Button android:id="@+id/btn_reset_source" style="@style/SettingButton" android:text="恢复默认播放源" />
                </LinearLayout>
                <Button android:id="@+id/check_update" style="@style/SettingButton" android:layout_marginTop="28dp" android:text="检查软件更新" />
                <TextView android:id="@+id/settings_version" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:textColor="#8290A3" android:textSize="15sp" />
            </LinearLayout>
        </ScrollView>
        <LinearLayout android:id="@+id/mobile_channel_drawer" android:layout_width="310dp" android:layout_height="match_parent" android:layout_gravity="start" android:background="#F20B121D" android:elevation="16dp" android:orientation="vertical" android:padding="16dp" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="14dp" android:text="选择频道" android:textColor="#78FFF0" android:textSize="22sp" android:textStyle="bold" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/mobile_drawer_channels" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="10dp" android:text="轻触画面或按返回键收起" android:textColor="#8290A3" android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
