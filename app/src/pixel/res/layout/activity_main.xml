<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#090B12" android:orientation="horizontal">
    <LinearLayout android:id="@+id/nav_rail" android:layout_width="190dp" android:layout_height="match_parent" android:background="#0D111A" android:orientation="vertical" android:padding="10dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="My IPTV" />
        <Button android:id="@+id/nav_home" style="@style/NavButton" android:text="大厅" />
        <Button android:id="@+id/nav_live" style="@style/NavButton" android:text="直播" />
        <Button android:id="@+id/nav_categories" style="@style/NavButton" android:text="分类" />
        <Button android:id="@+id/nav_settings" style="@style/NavButton" android:text="设置" />
        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
        <TextView android:id="@+id/nav_version" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    <FrameLayout android:id="@+id/page_container" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
        <LinearLayout android:id="@+id/page_home" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingLeft="12dp" android:paddingRight="12dp" android:paddingTop="18dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="▣  电视直播大厅" android:textColor="#F5F7FB" android:textSize="25sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="高清直播 · 连接延时实时测速" android:textColor="#8490A3" android:textSize="13sp" />
            <Button android:id="@+id/home_continue" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="14dp" android:backgroundTint="#3196F3" android:text="▶  继续播放" android:textColor="#07101A" android:textStyle="bold" />
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="58dp" android:scrollbars="none">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal">
                    <Button android:id="@+id/home_live" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginEnd="8dp" android:text="全部频道" />
                    <Button android:id="@+id/home_categories" android:layout_width="wrap_content" android:layout_height="44dp" android:text="频道分类" />
                </LinearLayout>
            </HorizontalScrollView>
            <androidx.recyclerview.widget.RecyclerView android:id="@id/home_channels" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="12dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/page_live" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:visibility="gone">
            <androidx.media3.ui.PlayerView android:id="@+id/player_view" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#000000" android:keepScreenOn="true" app:show_buffering="when_playing" app:use_controller="true" />
            <LinearLayout android:id="@+id/sidebar" android:layout_width="330dp" android:layout_height="match_parent" android:background="#0D111A" android:orientation="vertical" android:padding="10dp">
                <TextView android:id="@id/now_playing" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/mobile_card" android:padding="10dp" android:text="LIVE  请选择频道" android:textColor="#F5F7FB" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:paddingBottom="4dp" android:text="全部频道" android:textColor="#39A7FF" android:textSize="15sp" android:textStyle="bold" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/channels" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/page_categories" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:padding="12dp" android:visibility="gone">
            <LinearLayout android:layout_width="300dp" android:layout_height="match_parent" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="频道分类" android:textColor="#F5F7FB" android:textSize="20sp" android:textStyle="bold" android:paddingBottom="6dp"/>
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/category_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/category_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="请选择分类" android:textColor="#39A7FF" android:textSize="16sp" android:textStyle="bold" android:paddingBottom="6dp"/>
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/category_channels" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
        <ScrollView android:id="@+id/page_settings" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="设置" android:textColor="#F5F7FB" android:textSize="30sp" android:textStyle="bold"/><TextView style="@style/SettingLabel" android:layout_marginTop="24dp" android:text="启动后进入"/><Spinner android:id="@+id/startup_page" android:layout_width="match_parent" android:layout_height="58dp" android:background="@drawable/setting_control_background" android:popupBackground="#111C2A"/><androidx.appcompat.widget.SwitchCompat android:id="@+id/autoplay" android:layout_width="match_parent" android:layout_height="64dp" android:background="@drawable/setting_control_background" android:paddingLeft="14dp" android:paddingRight="14dp" android:text="进入直播时自动播放" android:textColor="#FFFFFF"/><Button android:id="@+id/check_update" style="@style/SettingButton" android:layout_width="match_parent" android:layout_height="58dp" android:text="检查软件更新"/><TextView android:id="@+id/settings_version" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:textColor="#8490A3"/></LinearLayout></ScrollView>
        <LinearLayout android:id="@+id/mobile_channel_drawer" android:layout_width="310dp" android:layout_height="match_parent" android:layout_gravity="start" android:background="#F20B121D" android:elevation="16dp" android:orientation="vertical" android:padding="12dp" android:visibility="gone"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="10dp" android:text="选择频道" android:textColor="#39A7FF" android:textSize="20sp" android:textStyle="bold"/><androidx.recyclerview.widget.RecyclerView android:id="@+id/mobile_drawer_channels" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="轻触画面或按返回键收起" android:textColor="#8490A3"/></LinearLayout>
    </FrameLayout>
</LinearLayout>
